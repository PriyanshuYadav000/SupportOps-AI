cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Testing and linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data and model artifacts
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

mlruns/

# IDE and OS
.vscode/
.idea/
.DS_Store
EOF